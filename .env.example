# Copy to a private environment file. Never commit the completed file.
DISCORD_TOKEN=
GUILD_ID=
TARGET_USER_ID=
OWNER_USER_ID=

# Optional extra user IDs allowed to pause, resume, and delete data.
ADMIN_USER_IDS=

# Legacy single-channel restriction. Blank allows commands anywhere in the guild.
# Setting an ID restricts all commands to that channel and makes general
# /leland reports public there.
OUTPUT_CHANNEL_ID=

# Public general reports in these channels; blank keeps them private everywhere.
# '*' makes them public wherever invoked, without restricting commands.
# /leland online and /tracker replies remain private.
PUBLIC_REPORT_CHANNEL_IDS=

# '*' means every text or voice channel the bot can see in the configured guild.
# Prefer comma-separated channel IDs to narrow collection when appropriate.
TEXT_CHANNEL_IDS=*
VOICE_CHANNEL_IDS=*
TIMEZONE=America/Costa_Rica
DATABASE_PATH=/var/lib/flock-cctv/tracker.sqlite3
BACKUP_DIR=/var/lib/flock-cctv/backups
CHECKPOINT_SECONDS=60
RETENTION_DAYS=90

